#######################
# Deployment Scripts
#
# - Deploying a new image sets the image reference of the container app to the latest image SHA, but our terraform config
#   uses `latest`. Each time you `tofu apply` you'll see this diff and that's completely ok since the latest container SHA
#   is also `latest`.
#
# - The only environment variable that is important for these operations is your OP_SERVICE_ACCOUNT_TOKEN and AZURE_SUBSCRIPTION_ID.
#   OP is required for pulling production secrets from `.env.backend.production` and AZURE_SUBSCRIPTION_ID is only required
#   if you have multiple azure subscriptions.
#
# - You'll want to set new environment variables here first, and then deploy. If you don't do this in the correct order, the deployment will fail.
#
# tofu_apply & azure_deploy are the two commands you'll want to understand.
#
#######################

# https://portal.azure.com/#@johncosmaneura.onmicrosoft.com/resource/subscriptions/bab2a709-1fcb-4c87-a9fc-802f7477ec13/resourceGroups/cosmaneura-prod/providers/Microsoft.App/containerApps/cosmaneura-prod-app-web/ingress

install:
	# yq is required for procfile parsing
	@if ! brew list | grep -q yq; then \
		echo "Installing yq..."; \
		brew install yq; \
	fi

	# opentofu
	@if ! brew list | grep -q opentofu; then \
		echo "Installing opentofu"; \
		brew install opentofu; \
	fi

	# azure cli
	@if ! brew list | grep -q azure-cli; then \
		echo "Installing azure-cli"; \
		brew install azure-cli; \
	fi

upgrade:
	az upgrade --yes
	HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade opentofu
	tofu init -upgrade

#######################
# Production Deployment
#######################

# TOFU_GLOBAL_OPTIONS := "-chdir=infra"
TOFU_GLOBAL_OPTIONS := ""

# TODO run some scripts to setup remote GH repo state for security, this is still WIP
# https://github.com/cli/cli/issues/8363

gh_config_output:
  gh api repos/$(gh repo view --json nameWithOwner -q '.nameWithOwner')/branches/master/protection/rules

# TODO we may be able to get rid of this with the federated creds
# set the container registry password in GHA which enables builds to be pushed to the registry
azure_gh-secrets:
	registry_password=$(just azure_output | jq -r '.acr_admin_password.value') && \
		gh secret set CONTAINER_REGISTRY_PASSWORD --app actions --body "$registry_password"

azure_open:
	open "https://portal.azure.com/$(az account show --query tenantId -o tsv)/"

tofu_init:
	tofu init

# Production apply must consume the founder-reviewed, current-source saved plan.
# A bare local apply could consume an old saved plan and revert runtime auth.
tofu_apply:
	@echo "Production applies require the reviewed Terraform Production Plan and founder-only Terraform Apply workflows."
	@exit 1

# additional azure configuration that cannot be done via tf
azure_configure:
	az extension add --name containerapp --allow-preview
	az containerapp env update --resource-group {{AZURE_RESOURCE_GROUP}} --name cosmaneura-prod-app-environment --logs-dynamic-json-columns true

tofu_output:
	tofu {{TOFU_GLOBAL_OPTIONS}} output -json

# open a interactive terminal on a production container
azure_shell container=AZURE_CONTAINER:
	@echo "{{BLUE}}Run 'alembic upgrade head' once the console is online to migrate the database{{NORMAL}}"
	@echo "{{BLUE}}Run './console.py' to open a python REPL{{NORMAL}}\n"
	az containerapp exec -n {{container}} -g {{AZURE_RESOURCE_GROUP}} --command 'sh -l'

# TODO azure doesn't like this :/
# open an ipython console in a production container
azure_ipy:
	az containerapp exec -n {{AZURE_CONTAINER}} -g {{AZURE_RESOURCE_GROUP}} --command '/app/console.py'

# TODO there are multiple resource groups
# TODO this string is copy/pasted in a couple of locations, should DRY up
AZURE_RESOURCE_GROUP := "cosmaneura-prod"
# TODO there are multiple containers in this app, need to document further
AZURE_CONTAINER := "cosmaneura-prod-app"

# view logs or open up a shell in a production container
azure_containers:
	az containerapp list -g {{AZURE_RESOURCE_GROUP}} --query "[].name" -o tsv | fzf \
		--height=40% \
		--layout=reverse \
		--no-preview \
		--header="alt-l: logs | ctrl-e: shell" \
		--prompt="Select Azure Container: " \
		--bind="alt-l:abort+execute(just azure_logs {})" \
		--bind="ctrl-e:execute(just azure_shell {})"

# instead of `heroku logs` we have this insane command we have to remember
azure_logs container=AZURE_CONTAINER:
	az containerapp logs show --follow -n {{container}} -g {{AZURE_RESOURCE_GROUP}}

# Audit the timeline of events for a single Zoom meeting id.
# usage: just azure_logs_for_meeting 83027877199
azure_logs_for_meeting meeting_id:
	az monitor log-analytics query -w '2a7d954b-373c-4de6-884f-c050ecc1d863' --analytics-query "union * | where TimeGenerated > ago(24h) | where ContainerAppName_s in ('cosmaneura-prod-app', 'cosmaneura-prod-worker') | where Log_meeting_id_s == '{{meeting_id}}' | project TimeGenerated, Log_event_s, Log_role_s, Log_user_name_s, Log_doctor_present_b, Log_recording_active_b, Log_patient_count_d, Log_bot_id_g, Log_appointment_id_s | order by TimeGenerated asc" -o table


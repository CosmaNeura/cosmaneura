# clean:

# once an image is built and pushed to the registry, this deploys it across all containers
azure_deploy:
	./deploy.sh $(just _azure_last_image_id)

@_azure_last_image_id:
	# deprecated command, but seems to work a bit faster
	# az acr repository show-manifests --name cosmaneuraprodregistry --repository cosmaneura/cosmaneura --query "[?tags[?contains(@, 'latest')]]"

	# an alternative approach is to pull the image and inspect the digest
	# however, this is slow and requires a full download of the image
	# docker pull cosmaneuraprodregistry.azurecr.io/cosmaneura/cosmaneura:latest
	# docker image inspect cosmaneuraprodregistry.azurecr.io/cosmaneura/cosmaneura:latest \
	# 	--format='\{\{index .RepoDigests 0\}\}' \
	# 	| cut -d '@' -f 2

	# non-deprecated command, but is marked as preview (lol!)
	az acr manifest list-metadata -r cosmaneuraprodregistry -n cosmaneura/cosmaneura --query "[?tags[?contains(@, 'latest')]].tags[0]" -o tsv 2>/dev/null

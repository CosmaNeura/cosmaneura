# Fixed, non-secret values required by the Cursor development environment.
if [ "${CI:-}" = true ]; then
  export API_BASE_URL=http://localhost:8205
else
  export API_BASE_URL=https://api.cosma.localhost
fi
export VITE_CLERK_PUBLIC_KEY=pk_test_placeholder
export CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLIC_KEY

# Replace every optional secret-backed integration value with a fixed empty or
# inert local placeholder after the shared environment has declined 1Password.
export SENTRY_DSN=
export VITE_SENTRY_DSN=
export ASSEMBLY_API_KEY=
export AZURE_UPLOADS_ACCOUNT_NAME=
export AZURE_UPLOADS_ACCOUNT_KEY=
export AZURE_UPLOADS_ACCOUNT_URL=
export AZURE_UPLOADS_CONTAINER_NAME=
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME=
export AZURE_DEID_TENANT_ID=
export AZURE_DEID_CLIENT_ID=
export AZURE_DEID_CLIENT_SECRET=
export AZURE_DEID_ENDPOINT=
export AZURE_OPENAI_API_KEY=
export AZURE_OPENAI_ENDPOINT=
export CLERK_PRIVATE_KEY=
export VITE_POSTHOG_KEY=
export VITE_POSTHOG_HOST=
export ZOOM_CLIENT_ID=cursor-local-placeholder
export ZOOM_CLIENT_SECRET=cursor-local-placeholder
export ZOOM_SECRET_TOKEN=cursor-local-placeholder
export RECALL_API_KEY=

# Do not expose 1Password coordinates to subprocesses after configuration.
unset OP_ACCOUNT
unset OP_PROD_VAULT_UID
unset OP_STAGING_VAULT_UID
unset OP_SHARED_VAULT_UID
unset OP_DEV_VAULT_UID
unset OP_SERVICE_ACCOUNT_TOKEN

# layout_uv prepends .venv/bin. Restore the repository denial shim to the front
# after all direnv layout and environment files have run.
export PATH="$PWD/.cursor/credential-neutral-bin:$PATH"

{
  "components": {
    "schemas": {
      "AuthorizationCodeExchange": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 43,
            "title": "Code",
            "type": "string"
          },
          "code_verifier": {
            "maxLength": 128,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9._~-]+$",
            "title": "Code Verifier",
            "type": "string"
          },
          "grant_type": {
            "const": "authorization_code",
            "title": "Grant Type",
            "type": "string"
          },
          "redirect_uri": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Redirect Uri",
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "code",
          "code_verifier",
          "redirect_uri"
        ],
        "title": "AuthorizationCodeExchange",
        "type": "object"
      },
      "BackendCaptureGrantResponse": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "title": "Actorid",
            "type": "string"
          },
          "captureSessionId": {
            "title": "Capturesessionid",
            "type": "string"
          },
          "consentRecordId": {
            "title": "Consentrecordid",
            "type": "string"
          },
          "consentStatus": {
            "const": "granted",
            "title": "Consentstatus",
            "type": "string"
          },
          "sessionStatus": {
            "const": "authorized",
            "title": "Sessionstatus",
            "type": "string"
          },
          "source": {
            "const": "desktop_companion",
            "title": "Source",
            "type": "string"
          },
          "sourceLeaseId": {
            "title": "Sourceleaseid",
            "type": "string"
          }
        },
        "required": [
          "captureSessionId",
          "actorId",
          "consentRecordId",
          "consentStatus",
          "sessionStatus",
          "source",
          "sourceLeaseId"
        ],
        "title": "BackendCaptureGrantResponse",
        "type": "object"
      },
      "CaptureCapabilityResponse": {
        "additionalProperties": false,
        "properties": {
          "capabilityId": {
            "title": "Capabilityid",
            "type": "string"
          },
          "expiresAt": {
            "title": "Expiresat",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "capabilityId",
          "secret",
          "expiresAt"
        ],
        "title": "CaptureCapabilityResponse",
        "type": "object"
      },
      "CaptureLifecycleDecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "const": "accepted",
            "title": "Decision",
            "type": "string"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "sessionStatus": {
            "enum": [
              "recording",
              "stopping"
            ],
            "title": "Sessionstatus",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "decision",
          "sessionStatus"
        ],
        "title": "CaptureLifecycleDecisionResponse",
        "type": "object"
      },
      "CaptureLifecycleRequest": {
        "additionalProperties": false,
        "description": "The capability identifier is the only client-supplied scope hint.",
        "properties": {
          "capabilityId": {
            "format": "uuid",
            "title": "Capabilityid",
            "type": "string"
          }
        },
        "required": [
          "capabilityId"
        ],
        "title": "CaptureLifecycleRequest",
        "type": "object"
      },
      "DesktopApiErrorResponse": {
        "additionalProperties": false,
        "description": "Value-free error body used by every `/desktop/v1` failure response.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "DesktopApiErrorResponse",
        "type": "object"
      },
      "DesktopTokenResponse": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "grant": {
            "$ref": "#/components/schemas/BackendCaptureGrantResponse"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "grant"
        ],
        "title": "DesktopTokenResponse",
        "type": "object"
      },
      "StartAuthorityDecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "title": "Actorid",
            "type": "string"
          },
          "captureCapability": {
            "$ref": "#/components/schemas/CaptureCapabilityResponse"
          },
          "captureSessionId": {
            "title": "Capturesessionid",
            "type": "string"
          },
          "consentRecordId": {
            "title": "Consentrecordid",
            "type": "string"
          },
          "consentStatus": {
            "const": "granted",
            "title": "Consentstatus",
            "type": "string"
          },
          "decision": {
            "const": "authorized",
            "title": "Decision",
            "type": "string"
          },
          "expiresAt": {
            "title": "Expiresat",
            "type": "string"
          },
          "issuedAt": {
            "title": "Issuedat",
            "type": "string"
          },
          "schemaVersion": {
            "const": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "sessionStatus": {
            "const": "authorized",
            "title": "Sessionstatus",
            "type": "string"
          },
          "source": {
            "const": "desktop_companion",
            "title": "Source",
            "type": "string"
          },
          "sourceLeaseId": {
            "title": "Sourceleaseid",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "decision",
          "captureSessionId",
          "actorId",
          "consentRecordId",
          "consentStatus",
          "sessionStatus",
          "source",
          "sourceLeaseId",
          "issuedAt",
          "expiresAt",
          "captureCapability"
        ],
        "title": "StartAuthorityDecisionResponse",
        "type": "object"
      },
      "StartAuthorizationRequest": {
        "additionalProperties": false,
        "description": "An intentionally empty request body.\n\nThe caller cannot assert actor, tenant, consent, lease, or provider data.",
        "properties": {},
        "title": "StartAuthorizationRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "desktopBearer": {
        "bearerFormat": "opaque",
        "description": "Short-lived opaque desktop session bearer. Keep it in the Tauri core process and never expose it to the webview.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Cosmaneura Desktop Capture API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/desktop/v1/capture-sessions/{capture_session_id}/heartbeats": {
      "post": {
        "description": "Consume the issued start capability and refresh the active lease.",
        "operationId": "record_desktop_capture_heartbeat",
        "parameters": [
          {
            "in": "path",
            "name": "capture_session_id",
            "required": true,
            "schema": {
              "title": "Capture Session Id",
              "type": "string"
            }
          },
          {
            "description": "Unique key for this logical operation; reuse it only when retrying the same request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureLifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureLifecycleDecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The desktop bearer was missing or invalid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition was denied."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition conflicts with current state."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the service contract."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "Desktop capture is unavailable."
          }
        },
        "security": [
          {
            "desktopBearer": []
          }
        ],
        "summary": "Record Desktop Capture Heartbeat",
        "tags": [
          "desktop-capture"
        ]
      }
    },
    "/desktop/v1/capture-sessions/{capture_session_id}/segments/start-authorizations": {
      "post": {
        "description": "Issue one provider-neutral, short-lived physical-start capability.",
        "operationId": "authorize_desktop_capture_segment_start",
        "parameters": [
          {
            "in": "path",
            "name": "capture_session_id",
            "required": true,
            "schema": {
              "title": "Capture Session Id",
              "type": "string"
            }
          },
          {
            "description": "Unique key for this logical operation; reuse it only when retrying the same request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/StartAuthorizationRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Data"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartAuthorityDecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The desktop bearer was missing or invalid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition was denied."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition conflicts with current state."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the service contract."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "Desktop capture is unavailable."
          }
        },
        "security": [
          {
            "desktopBearer": []
          }
        ],
        "summary": "Authorize Desktop Capture Segment Start",
        "tags": [
          "desktop-capture"
        ]
      }
    },
    "/desktop/v1/capture-sessions/{capture_session_id}/stop-requests": {
      "post": {
        "description": "Record a stop request without claiming provider-stop evidence.",
        "operationId": "request_desktop_capture_stop",
        "parameters": [
          {
            "in": "path",
            "name": "capture_session_id",
            "required": true,
            "schema": {
              "title": "Capture Session Id",
              "type": "string"
            }
          },
          {
            "description": "Unique key for this logical operation; reuse it only when retrying the same request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureLifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureLifecycleDecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The desktop bearer was missing or invalid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition was denied."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The requested capture transition conflicts with current state."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the service contract."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "Desktop capture is unavailable."
          }
        },
        "security": [
          {
            "desktopBearer": []
          }
        ],
        "summary": "Request Desktop Capture Stop",
        "tags": [
          "desktop-capture"
        ]
      }
    },
    "/desktop/v1/oauth/token": {
      "post": {
        "description": "Exchange one code plus its PKCE verifier for a main-process token/grant.",
        "operationId": "exchange_desktop_capture_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationCodeExchange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The request or authorization grant was rejected."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the service contract."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopApiErrorResponse"
                }
              }
            },
            "description": "Desktop capture is unavailable."
          }
        },
        "summary": "Exchange Desktop Capture Code",
        "tags": [
          "desktop-capture"
        ]
      }
    }
  }
}

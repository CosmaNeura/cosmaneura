    "tablespaces": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
    "replication_slots": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
    "parameter_privileges": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
    "shared_security_labels": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
    "settings": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"}
  },
  "expected_databases": [
    {
      "identity_hmac": "CONFIGURE_DATABASE_IDENTITY_HMAC_SHA256",
      "is_template": false,
      "allow_connections": true,
      "status": "fingerprinted",
      "surfaces": {
        "schema": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "extensions": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "foreign_data_wrappers": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "foreign_servers": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "foreign_tables": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "user_mappings": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "publications": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "publication_memberships": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "subscriptions": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "subscription_relations": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "security_labels": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "event_triggers": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"},
        "large_objects": {"count": -1, "hmac": "CONFIGURE_HMAC_SHA256"}

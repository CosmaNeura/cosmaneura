        "candidate.json",
        "evidence-manifest.json",
        "inventory.json",
        "quiescence.json",
        "server-scope.json"
      ],
      "exact_file_set_required": true,
      "directory_enumerations": 1,
      "reads_per_file": 1,
      "maximum_bytes_per_file": 8388608,
      "maximum_total_bytes": 50331648,
      "owner_or_root_owned_files_required": true,
      "group_or_world_writable_files_permitted": false,
      "symlinks_permitted": false,
      "expected_sha256_source": "validated_provision_launch_record.payload.evidence_files"
    },
    "hmac_key": {
      "type": "absolute_file_path",
      "reads": 1,
      "minimum_bytes": 32,
      "maximum_bytes": 4096,
      "exact_mode": "0600",
      "owner_owned_required": true,
      "symlinks_permitted": false,
      "all_file_bytes_are_key_material": true,
      "expected_sha256_source": "validated_provision_launch_record.payload.server_scope_hmac_key.decoded_sha256"
    },
    "attestation_bundle": {
      "type": "absolute_file_path",
      "reads": 1,
      "minimum_bytes": 1,
      "maximum_bytes": 2097152,
      "owner_or_root_owned_required": true,
      "group_or_world_writable_permitted": false,
      "symlinks_permitted": false,
      "expected_sha256_source": "validated_provision_launch_record.payload.github_attestation_bundle.sha256"
    },
    "trusted_root": {
      "type": "absolute_file_path",
      "reads": 1,
      "minimum_bytes": 1,
      "maximum_bytes": 1048576,
      "owner_or_root_owned_required": true,
      "group_or_world_writable_permitted": false,
      "symlinks_permitted": false,
      "delivery": "independent_of_attestation_bundle_and_subject",
      "expected_sha256_source": "validated_provision_launch_record.github_trusted_root.sha256"
    },
    "ttl_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "source": "validated_provision_launch_record.payload.ttl_hours",
      "caller_override_permitted": false
    },
    "caller_authority_overrides_permitted": [],
    "environment_authority_inputs_permitted": false
  },
  "snapshot_rules": {
    "file_open_sequence": [
      "lstat",
      "open_read_only_no_follow",
      "fstat_identity_match",
      "bounded_read",
      "close"
    ],
    "retain_exact_bytes_until_submit_returns": [

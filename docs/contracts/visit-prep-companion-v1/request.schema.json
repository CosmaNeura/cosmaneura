{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Visit Prep companion read request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "action",
    "purpose",
    "preparation_ref",
    "expected_actor_ref",
    "expected_tenant_ref",
    "connection_sha256",
    "workspace_id",
    "request_nonce"
  ],
  "properties": {
    "contract_version": { "const": "1" },
    "action": { "const": "visit-prep.open" },
    "purpose": { "const": "provider_previsit_review" },
    "preparation_ref": {
      "type": "string",
      "pattern": "^visit_prep_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "expected_actor_ref": {
      "type": "string",
      "pattern": "^authority_actor_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "expected_tenant_ref": {
      "type": "string",
      "pattern": "^authority_tenant_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "connection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "request_nonce": { "type": "string", "format": "uuid" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmaneura.local/cosmaneura-agent-broker-context-v1.schema.json",
  "title": "Cosmaneura trusted agent broker context v1",
  "description": "Trusted values supplied by the broker when stamping a model assessment draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_version",
    "assessment_kind",
    "producer",
    "policy_sha",
    "subject",
    "risk_tier_floor",
    "generated_at",
    "evidence_fresh_until",
    "evidence_policy",
    "input_digest"
  ],
  "properties": {
    "context_version": {
      "const": "cosmaneura.agent-broker-context.v1"
    },
    "assessment_kind": {
      "enum": [
        "deployment_assessment",
        "migration_assessment",
        "release_assessment",
        "security_assessment"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "policy_version",
        "foundry_agent_version",
        "model"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "policy_version": {
          "description": "Semantic version of the checked-in agent policy bundle.",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "foundry_agent_version": {
          "description": "Immutable numeric Azure AI Foundry agent version invoked by the broker.",
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "policy_sha": {
      "$ref": "#/$defs/sha"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_sha",
        "head_sha",
        "environment"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "$ref": "#/$defs/sha"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      }
    },
    "risk_tier_floor": {
      "enum": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_fresh_until": {
      "description": "Trusted broker deadline after which workers must not consume the assessment.",
      "type": "string",
      "format": "date-time"
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidencePolicy"
    },
    "input_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceLocator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.][A-Za-z0-9._:/-]{0,255}$"
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_action_evidence_locators",
        "evidence_manifest",
        "pull_request",
        "checks",
        "scanner_coverage",
        "semantic_source",
        "migration_rehearsal"
      ],
      "properties": {
        "allowed_action_evidence_locators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceLocator"
          }
        },
        "evidence_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2500,
          "items": {
            "$ref": "#/$defs/evidenceManifestItem"
          }
        },
        "pull_request": {
          "$ref": "#/$defs/pullRequestEvidence"
        },
        "checks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/checkEvidence"
          }
        },
        "scanner_coverage": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/scannerEvidence"
          }
        },
        "semantic_source": {
          "$ref": "#/$defs/availabilityEvidence"
        },
        "migration_rehearsal": {
          "$ref": "#/$defs/migrationRehearsalEvidence"
        }
      }
    },
    "evidenceManifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "availability",
        "required_for_deployment"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "required_for_deployment": {
          "type": "boolean"
        }
      }
    },
    "pullRequestEvidence": {
      "description": "Null only for a release assessment that is not sourced from a pull request.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "locator",
        "state",
        "draft"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "check_run_id",
        "name",
        "required",
        "status",
        "conclusion"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "check_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "queued",
            "in_progress",
            "completed",
            "pending",
            "requested",
            "waiting"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "success",
            "failure",
            "neutral",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "startup_failure",
            "stale"
          ]
        }
      }
    },
    "scannerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "scanner",
        "status"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "scanner": {
          "enum": [
            "CodeQL/SAST",
            "dependency",
            "secret",
            "IaC",
            "SBOM",
            "container"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_configured"
          ]
        }
      }
    },
    "availabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "status"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      }
    },
    "migrationRehearsalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "status"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unavailable"
          ]
        }
      }
    }
  }
}

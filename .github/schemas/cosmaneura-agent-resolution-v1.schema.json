{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmaneura.local/cosmaneura-agent-resolution-v1.schema.json",
  "title": "Cosmaneura agent action resolution receipt v1",
  "description": "A worker's immutable response to actions in one exact assessment artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "assessment",
    "resolver",
    "new_head_sha",
    "resolutions",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "cosmaneura.agent-resolution.v1"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head_sha",
        "artifact_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "agent_version"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "agent_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "new_head_sha": {
      "$ref": "#/$defs/sha"
    },
    "resolutions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resolutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "claim"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "status",
        "explanation",
        "evidence"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^(?:DEP|MIG|REL|SEC)-[0-9]{3,}$"
        },
        "status": {
          "enum": [
            "fixed",
            "blocked",
            "not_applicable"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resolutionEvidence"
          }
        }
      }
    }
  }
}

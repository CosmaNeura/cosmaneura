export NODE_ENV=staging

export VITE_PYTHON_URL="https://staging-app.cosmaneura.com/"
export VITE_INTAKE_CHAT_DOMAIN=staging-chat.cosmaneura.com

# Provider assistant stays off until both the HTTPS deployment origin and a
# Clerk JWT template accepted by that deployment are explicitly configured.
export VITE_SOVEREIGN_URL="${VITE_SOVEREIGN_URL:-}"
export VITE_SOVEREIGN_CLERK_JWT_TEMPLATE="${VITE_SOVEREIGN_CLERK_JWT_TEMPLATE:-}"

export OP_PROD_VAULT_UID=nvrvpa674pfgzoo6u534lhjjr4
export OP_STAGING_VAULT_UID=a747na7sgxngfa7gczsqqwekfq
export OP_DEV_VAULT_UID=g46wit25zdsr2ul7yivj4air2u

export OPENAPI_JSON_PATH=openapi.json

export VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-https://examplePublicKey@o0.ingest.sentry.io/0}"
export VITE_CLERK_PUBLIC_KEY="${VITE_CLERK_PUBLIC_KEY:-pk_test_placeholder}"
export VITE_POSTHOG_KEY="${VITE_POSTHOG_KEY:-test-posthog-key}"
export VITE_POSTHOG_HOST="${VITE_POSTHOG_HOST:-https://app.posthog.com}"

if op whoami >/dev/null 2>&1; then
	source <(
		cat <<'EOF' | op inject
export VITE_SENTRY_DSN="op://${OP_DEV_VAULT_UID}/sentry-runtime/frontend-dsn"
export VITE_CLERK_PUBLIC_KEY="op://${OP_STAGING_VAULT_UID}/clerk-staging-api/publishable_key"
export VITE_POSTHOG_KEY="op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/public-key"
export VITE_POSTHOG_HOST="op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/posthog-host"

# TODO: separate sentry-release per environment; for now using production vault
export SENTRY_AUTH_TOKEN="op://${OP_PROD_VAULT_UID}/sentry-release/authorization-token"
export SENTRY_ORG="op://${OP_PROD_VAULT_UID}/sentry-release/organization-slug"
export SENTRY_PROJECT="op://${OP_PROD_VAULT_UID}/sentry-release/frontend-project"
EOF
	)
fi

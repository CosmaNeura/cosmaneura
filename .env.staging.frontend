export NODE_ENV=staging

export VITE_PYTHON_URL="https://staging-app.cosmaneura.com/"
export VITE_INTAKE_CHAT_DOMAIN=staging-chat.cosmaneura.com
export VITE_SOVEREIGN_PROVIDER_URL="${VITE_SOVEREIGN_PROVIDER_URL:-https://staging-sovereign.cosmaneura.com}"
export VITE_SOVEREIGN_CLERK_TEMPLATE="${VITE_SOVEREIGN_CLERK_TEMPLATE:-cosmaneura-sovereign}"

export OP_STAGING_VAULT_UID=a747na7sgxngfa7gczsqqwekfq

export OPENAPI_JSON_PATH=openapi.json

# Protected builds fail closed unless every required value is present in the
# staging vault and accessible to the staging-only service account.
op_inject_source <<'EOF'
export VITE_SENTRY_DSN="op://${OP_STAGING_VAULT_UID}/sentry-runtime/frontend-dsn"
export VITE_CLERK_PUBLIC_KEY="op://${OP_STAGING_VAULT_UID}/clerk-staging-api/publishable_key"
export VITE_POSTHOG_KEY="op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/public-key"
export VITE_POSTHOG_HOST="op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/posthog-host"
EOF

{
  "name": "@cosmaneura/desktop-companion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-ts",
    "build": "openapi-ts && tsc --noEmit && vite build",
    "check": "node ./scripts/verify-desktop-contract.mjs && openapi-ts && tsc --noEmit && vitest run && vite build",
    "api:verify": "node ./scripts/verify-desktop-contract.mjs",
    "dev": "vite --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@tauri-apps/cli": "^2.8.4",
    "@tailwindcss/vite": "^4.0.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^17.4.4",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": "^22.11.0",
    "pnpm": ">=9.15.9 <12"
  }
}

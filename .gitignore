# NOTE use the `web/` gitignore for web-specific ignores

.ipython_history
.DS_Store
.venv
.pytest_cache
.ruff_cache
__pycache__
.mypy_cache

*.env.*local

.nixpacks

# TODO this should really be redirected to a tmp/ directory
.coverage

# for hacking on packages within this repo
/pypi

# for logs and other system-generated files that can be safely wiped
/tmp/*

# for scripts, dumps, etc that are strictly for personal use
/playground/*

/public

# plugin installation folder
infra/.terraform
infra-staging/.terraform
# this contains secrets!
infra/terraform.tfstate*
infra-staging/terraform.tfstate*
.superpowers/
.worktrees/

docs/superporwers

# Tauri desktop companion build products and local environment overrides
/desktop/node_modules/
/desktop/dist/
/desktop/src/generated/
/desktop/src-tauri/gen/
/desktop/src-tauri/target/
/desktop/.env*
!/desktop/.env.example

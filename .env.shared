# NOTE common configuration for testing and development
#
#   - Some configuration here is testing specific, but changing *all* environment variables
#     to test mode is a pain, so we include them here to easily run pytest and friends locally.
#   - Do NOT include quotes in any of the values here. This will cause downstream issues when building containers.
#     Docker does not like quotes in any of it's env files or vars.

# required when running pytest, python, etc; not required when running fastapi and ipython
# PYTHONSAFEPATH=1 prevents PWD from being added to sys.path automatically
export PYTHONPATH=.

# use a non-standard port to avoid conflicts with other applications
export PYTHON_SERVER_PORT=8205
export PYTHON_TEST_SERVER_PORT=8206
export PYTHON_TEST_SERVER_HOST=api-test.cosma.localhost

# we don't want users accidentally attempting to get into the primary app
export INTAKE_CHAT_DOMAIN=chat.cosma.localhost
export VITE_INTAKE_CHAT_DOMAIN=$INTAKE_CHAT_DOMAIN

# job monitoring configuration
export FLOWER_PASSWORD=password
export FLOWER_PORT=8208

# output directory is used by CI and justfiles
export TMP_DIRECTORY=tmp
export TEST_RESULTS_DIRECTORY=$TMP_DIRECTORY/test-results
export PLAYWRIGHT_RESULT_DIRECTORY=$TEST_RESULTS_DIRECTORY/playwright
export PLAYWRIGHT_VISUAL_SNAPSHOT_DIRECTORY=tests/integration/__snapshots__

# used for py tests, justfile recipes, and JS build
# use an absolute path since this is run from within `web/`
export OPENAPI_JSON_PATH=$PWD/web/openapi.json

# only applicable in development, javascript is bundled in the py container in prod
export JAVASCRIPT_SERVER_PORT=8207
export JAVASCRIPT_SERVER_HOST=cosma.localhost

# protocol is important, otherwise you'll get CORS errors in browser
export VITE_PYTHON_URL="https://api.cosma.localhost/"

# default from address for the mailer system
export EMAIL_FROM_ADDRESS=hello@cosmaneura.com

# set these conditionally so they be overwritten by CI (or `.env.local`), which has a different server configuration
if [ -z "${DATABASE_HOST:-}" ] && [ -z "${REDIS_HOST:-}" ] && [ -z "${SMTP_HOST:-}" ]; then
  # default to localhost for maximum compatibility.
  # users on OrbStack can still override in `.env.local`.
  REDIS_HOST=localhost
  DATABASE_HOST=localhost
  SMTP_HOST=localhost
fi

# names are important here: pg_isready and docker configuration requires these
# if you are not using docker for local postgres and redis, you can change these
export POSTGRES_USER=root
export POSTGRES_PASSWORD=password
export POSTGRES_DB=development

export REDIS_URL=redis://${REDIS_HOST}:6379/1
export DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:5432/development
export SMTP_URL=smtp://${SMTP_HOST}:1025

#######################
# Secrets
#######################

# NOTE OP_ACCOUNT and vault UIDs are *not* required when using a service account to access, which is what is used
#      on CI. This is because `OP_SERVICE_ACCOUNT_TOKEN` is tied to a single vault.

# specify the 1p account that should be used to source secrets via `op read`
export OP_ACCOUNT=cosmaneurainc.1password.com

# multi-vault setup
export OP_PROD_VAULT_UID=nvrvpa674pfgzoo6u534lhjjr4
export OP_STAGING_VAULT_UID=a747na7sgxngfa7gczsqqwekfq
export OP_SHARED_VAULT_UID=6mlh6mrbycvfitfwv32f3cnrpu
export OP_DEV_VAULT_UID=g46wit25zdsr2ul7yivj4air2u

OP_AVAILABLE=1
if ! op whoami >/dev/null 2>&1; then
  OP_AVAILABLE=0
fi

op_read_if_available() {
  local secret_ref="$1"

  if [ "$OP_AVAILABLE" = "1" ]; then
    op read "$secret_ref"
  fi
}

# random secret key for fastapi session signing
export SESSION_SECRET_KEY=de76c21e-e79d-4ad8-8e89-80ec58c71997

# AES-256 (Fernet) key for encrypting OAuth tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production/staging keys live in 1Password.
export ENCRYPTION_KEY="${ENCRYPTION_KEY:-pafFwl-iu38WvEl0y0e4n9OQn6YuYbZQL9hwDmaSB74=}"

# block bad hosts in fastapi. not required for development, but helpful to keep prod vs dev consistent
# in production, this is most likely only a single host but can support multiple hosts
export ALLOWED_HOST_LIST="$JAVASCRIPT_SERVER_HOST,$PYTHON_TEST_SERVER_HOST,$INTAKE_CHAT_DOMAIN,api.cosma.localhost${EXTRA_ALLOWED_HOSTS:-}"

# NOTE OP references with names can change over time and introduce mutation risk, which is why we use the UIDs instead

# Sentry
export SENTRY_DSN="${SENTRY_DSN:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/sentry-runtime/backend-dsn")}"
export VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/sentry-runtime/frontend-dsn")}"

# AssemblyAI
export ASSEMBLY_API_KEY="${ASSEMBLY_API_KEY:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/assemblyai-runtime/api-key")}"

# Azure Uploads
export AZURE_UPLOADS_ACCOUNT_NAME="${AZURE_UPLOADS_ACCOUNT_NAME:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-uploads-test-runtime/account-name")}"
export AZURE_UPLOADS_ACCOUNT_KEY="${AZURE_UPLOADS_ACCOUNT_KEY:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-uploads-test-runtime/password")}"
export AZURE_UPLOADS_ACCOUNT_URL="${AZURE_UPLOADS_ACCOUNT_URL:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-uploads-test-runtime/website")}"
export AZURE_UPLOADS_CONTAINER_NAME="${AZURE_UPLOADS_CONTAINER_NAME:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-uploads-test-runtime/uploads-container-name")}"
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME="${AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-uploads-test-runtime/example-notes-container-name")}"

# Azure DeID
export AZURE_DEID_TENANT_ID="${AZURE_DEID_TENANT_ID:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-deid-test-runtime/tenant-id")}"
export AZURE_DEID_CLIENT_ID="${AZURE_DEID_CLIENT_ID:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-deid-test-runtime/client-id")}"
export AZURE_DEID_CLIENT_SECRET="${AZURE_DEID_CLIENT_SECRET:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-deid-test-runtime/client-secret")}"
export AZURE_DEID_ENDPOINT="${AZURE_DEID_ENDPOINT:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/azure-deid-test-runtime/endpoint")}"

# OpenAI / Azure OpenAI
# export OPENAI_API_KEY="$(op_read_if_available "op://${OP_SHARED_VAULT_UID}/3kilfl4b5gegds7anifvali6zu/credential")"
export AZURE_OPENAI_API_KEY="${AZURE_OPENAI_API_KEY:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/azure-openai-staging-runtime/password")}"
export AZURE_OPENAI_ENDPOINT="${AZURE_OPENAI_ENDPOINT:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/azure-openai-staging-runtime/website")}"

# Clerk
export CLERK_PRIVATE_KEY="${CLERK_PRIVATE_KEY:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/clerk-staging-api/secret_key")}"
export VITE_CLERK_PUBLIC_KEY="${VITE_CLERK_PUBLIC_KEY:-${CLERK_PUBLISHABLE_KEY:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/clerk-staging-api/publishable_key")}}"
export CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLIC_KEY:-}

# PostHog
export VITE_POSTHOG_KEY="${VITE_POSTHOG_KEY:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/public-key")}"
export VITE_POSTHOG_HOST="${VITE_POSTHOG_HOST:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/posthog-staging-runtime/posthog-host")}"

# Zoom
export ZOOM_CLIENT_ID="${ZOOM_CLIENT_ID:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/zoom-cosma-app-dev/client-id")}"
export ZOOM_CLIENT_SECRET="${ZOOM_CLIENT_SECRET:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/zoom-cosma-app-dev/client-secret")}"
export ZOOM_SECRET_TOKEN="${ZOOM_SECRET_TOKEN:-$(op_read_if_available "op://${OP_DEV_VAULT_UID}/zoom-cosma-app-dev/secret-token")}"

# Recall
export RECALL_API_KEY="${RECALL_API_KEY:-$(op_read_if_available "op://${OP_STAGING_VAULT_UID}/recall-staging-api-key/credential")}"
export RECALL_API_BASE="${RECALL_API_BASE:-https://us-west-2.recall.ai/api/v1}"

# NOTE This line is very important! This turns off dev dependencies *within* the docker build it's unclear if this
#      is the optimal approach. The logic here is the build process *is* the production environment since it's a SPA
#      so we want to simulate that environment the best we can.
export NODE_ENV=production

export VITE_PYTHON_URL="https://app.cosmaneura.com/"
export VITE_INTAKE_CHAT_DOMAIN=chat.cosmaneura.com
export VITE_SOVEREIGN_PROVIDER_URL="${VITE_SOVEREIGN_PROVIDER_URL:-https://sovereign.cosmaneura.com}"
export VITE_SOVEREIGN_CLERK_TEMPLATE="${VITE_SOVEREIGN_CLERK_TEMPLATE:-cosmaneura-sovereign}"

export OP_PROD_VAULT_UID=nvrvpa674pfgzoo6u534lhjjr4
export OP_DEV_VAULT_UID=g46wit25zdsr2ul7yivj4air2u

# one of the few duplicated env variables, required for the openapi build
export OPENAPI_JSON_PATH=openapi.json

export VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-https://examplePublicKey@o0.ingest.sentry.io/0}"
export VITE_CLERK_PUBLIC_KEY="${VITE_CLERK_PUBLIC_KEY:-pk_test_placeholder}"
export VITE_POSTHOG_KEY="${VITE_POSTHOG_KEY:-test-posthog-key}"
export VITE_POSTHOG_HOST="${VITE_POSTHOG_HOST:-https://app.posthog.com}"

# `inject` is much faster than individually sourcing keys with `op read`
# IMPORTANT: these should only be used in production!
if op whoami >/dev/null 2>&1; then
	source <(
		cat <<'EOF' | op inject
export VITE_SENTRY_DSN="op://${OP_DEV_VAULT_UID}/sentry-runtime/frontend-dsn"
export VITE_CLERK_PUBLIC_KEY='op://${OP_PROD_VAULT_UID}/clerk-production-api/publishable_key'
export VITE_POSTHOG_KEY="op://${OP_PROD_VAULT_UID}/posthog-production-runtime/public-key"
export VITE_POSTHOG_HOST="op://${OP_PROD_VAULT_UID}/posthog-production-runtime/posthog-host"

export SENTRY_AUTH_TOKEN="op://${OP_PROD_VAULT_UID}/sentry-release/authorization-token"
export SENTRY_ORG="op://${OP_PROD_VAULT_UID}/sentry-release/organization-slug"
export SENTRY_PROJECT="op://${OP_PROD_VAULT_UID}/sentry-release/frontend-project"
EOF
	)
fi

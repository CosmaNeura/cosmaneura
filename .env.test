export PYTHON_ENV=test
export NODE_ENV=test

# One the tricky aspects of a test environment is integration tests
# we want these to run as closely to the production environment as possible
# this means HTTPS support and using production-build javascript.
#
# However, When running tests locally we want to:
#
#   * Use a separate database
#   * Use a separate domain so we can run a local server in parallel
#   * Because a separate domain is used, we'll need to use a different report
#     and change the domain used by the javascript client.

export VITE_PYTHON_URL="https://${PYTHON_TEST_SERVER_HOST}"

# There are test assets sitting in these azure blobs. They should not be removed.
export AZURE_UPLOADS_CONTAINER_NAME="test-uploads"
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME="test-example-notes"

# additional arguments you want to always set on pytest
# export PYTEST_ADDOPTS='--arg example '

# TODO maybe we should move this to a `build` config that only gets loaded on GHA

source <(
  cat <<'EOF' | op inject
export AZURE_CLIENT_ID="op://${OP_VAULT_UID}/ds255qvw6lwepxfqjdoduhtpey/client-id"
export AZURE_TENANT_ID="op://${OP_VAULT_UID}/ds255qvw6lwepxfqjdoduhtpey/tenant-id"
export AZURE_SUBSCRIPTION_ID="op://${OP_VAULT_UID}/ds255qvw6lwepxfqjdoduhtpey/subscription-id"
EOF
)

source <(
  cat <<'EOF' | op inject
export CONTAINER_REGISTRY_HOST="op://${OP_VAULT_UID}/irsqvxwabp4d2qxl4tw2fztywe/url"
export CONTAINER_REGISTRY_USERNAME="op://${OP_VAULT_UID}/irsqvxwabp4d2qxl4tw2fztywe/username"
EOF
)

source <(
  cat <<'EOF' | op inject
export AZURE_UPLOADS_ACCOUNT_NAME="op://${OP_VAULT_UID}/pqcbsqpfpcyap2nzkz3w4krkcy/main/account-name"
export AZURE_UPLOADS_ACCOUNT_KEY="op://${OP_VAULT_UID}/pqcbsqpfpcyap2nzkz3w4krkcy/password"
export AZURE_UPLOADS_ACCOUNT_URL="op://${OP_VAULT_UID}/pqcbsqpfpcyap2nzkz3w4krkcy/url"
EOF
)

# we should prevent local machines from pushing to the container registry
# export CONTAINER_REGISTRY_PASSWORD

# Use staging Azure OpenAI credentials for tests (overrides .env.shared production credentials)
export AZURE_OPENAI_API_KEY="op://${OP_VAULT_UID}/ldrekeacnvieqdjzdw53oe2qju/password"
export AZURE_OPENAI_ENDPOINT="op://${OP_VAULT_UID}/ldrekeacnvieqdjzdw53oe2qju/website"

export PYTHON_ENV=test
export NODE_ENV=test

# One the tricky aspects of a test environment is integration tests
# we want these to run as closely to the production environment as possible
# this means HTTPS support and using production-build javascript.
#
# However, When running tests locally we want to:
#
#   * Use a separate database
#   * Use a separate domain so we can run a local server in parallel
#   * Because a separate domain is used, we'll need to use a different report
#     and change the domain used by the javascript client.

export VITE_PYTHON_URL="https://${PYTHON_TEST_SERVER_HOST}"

# there is a set of test assets sitting in azure blob that should never be removed
export AZURE_UPLOADS_CONTAINER_NAME="test-uploads"

# additional arguments you want to always set on pytest
# export PYTEST_ADDOPTS='--arg example '

# TODO maybe we should move this to a `build` config that only gets loaded on GHA

source <(
  cat <<'EOF' | op inject
export AZURE_CLIENT_ID="op://${OP_VAULT_UID}/nca24hn6x3agmkrf53anodr75i/client-id"
export AZURE_TENANT_ID="op://${OP_VAULT_UID}/nca24hn6x3agmkrf53anodr75i/tenant-id"
export AZURE_SUBSCRIPTION_ID="op://${OP_VAULT_UID}/nca24hn6x3agmkrf53anodr75i/subscription-id"

export CONTAINER_REGISTRY_HOST="op://${OP_VAULT_UID}/m2d2pghhyzhsbg2z6ppr2dtcwq/website"
export CONTAINER_REGISTRY_USERNAME="op://${OP_VAULT_UID}/m2d2pghhyzhsbg2z6ppr2dtcwq/username"
EOF

)

export AZURE_UPLOADS_CONTAINER_NAME="test-uploads"
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME="test-example-notes"

# we should prevent local machines from pushing to the container registry
# export CONTAINER_REGISTRY_PASSWORD

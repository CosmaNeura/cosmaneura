export PYTHON_ENV=test
export NODE_ENV=test

# One the tricky aspects of a test environment is integration tests
# we want these to run as closely to the production environment as possible
# this means HTTPS support and using production-build javascript.
#
# However, When running tests locally we want to:
#
#   * Use a separate database
#   * Use a separate domain so we can run a local server in parallel
#   * Because a separate domain is used, we'll need to use a different report
#     and change the domain used by the javascript client.

export VITE_PYTHON_URL="https://${PYTHON_TEST_SERVER_HOST}"

# Zoom vars are required at import time by app.configuration.zoom.
# Use non-secret test placeholders so pytest collection does not fail.
export ZOOM_CLIENT_ID="test-zoom-client-id"
export ZOOM_CLIENT_SECRET="test-zoom-client-secret"
export ZOOM_SECRET_TOKEN="test-zoom-secret-token"
export ZOOM_REDIRECT_URI="http://localhost:8205/external/v1/zoom-oauth-callback"
export ZOOM_SUCCESS_REDIRECT="http://localhost:8207/settings"
export API_BASE_URL="http://localhost:8205"

# There are test assets sitting in these azure blobs. They should not be removed.
export AZURE_UPLOADS_CONTAINER_NAME="test-uploads"
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME="test-example-notes"

# additional arguments you want to always set on pytest
# export PYTEST_ADDOPTS='--arg example '

# TODO maybe we should move this to a `build` config that only gets loaded on GHA

# we should prevent local machines from pushing to the container registry
# export CONTAINER_REGISTRY_PASSWORD

# Use staging Azure Identity credentials for tests (overrides .env.shared production credentials)
if [ "${OP_AVAILABLE:-1}" = "1" ]; then
  source <(
    cat <<'EOF' | op inject
export AZURE_CLIENT_ID="op://${OP_STAGING_VAULT_UID}/azure-identity-staging-runtime/client-id"
export AZURE_TENANT_ID="op://${OP_STAGING_VAULT_UID}/azure-identity-staging-runtime/tenant-id"
export AZURE_SUBSCRIPTION_ID="op://${OP_STAGING_VAULT_UID}/azure-identity-staging-runtime/subscription-id"
EOF
  )
fi

# Use staging Container Registry credentials for tests
if [ "${OP_AVAILABLE:-1}" = "1" ]; then
  source <(
    cat <<'EOF' | op inject
export CONTAINER_REGISTRY_HOST="op://${OP_STAGING_VAULT_UID}/acr-staging-registry/registry_host"
export CONTAINER_REGISTRY_USERNAME="op://${OP_STAGING_VAULT_UID}/acr-staging-registry/oh3lrknnbm7zl66wgx4aqwzgsu"
EOF
  )
fi

# Use staging Azure Uploads storage credentials for tests
if [ "${OP_AVAILABLE:-1}" = "1" ]; then
  source <(
    cat <<'EOF' | op inject
export AZURE_UPLOADS_ACCOUNT_NAME="op://${OP_STAGING_VAULT_UID}/azure-uploads-staging-runtime/main/account-name"
export AZURE_UPLOADS_ACCOUNT_KEY="op://${OP_STAGING_VAULT_UID}/azure-uploads-staging-runtime/password"
export AZURE_UPLOADS_ACCOUNT_URL="op://${OP_STAGING_VAULT_UID}/azure-uploads-staging-runtime/url"
EOF
  )
fi

# Use staging Azure OpenAI credentials for tests
if [ "${OP_AVAILABLE:-1}" = "1" ]; then
  source <(
    cat <<'EOF' | op inject
export AZURE_OPENAI_API_KEY="op://${OP_STAGING_VAULT_UID}/azure-openai-staging-runtime/password"
export AZURE_OPENAI_ENDPOINT="op://${OP_STAGING_VAULT_UID}/azure-openai-staging-runtime/website"
EOF
  )
fi

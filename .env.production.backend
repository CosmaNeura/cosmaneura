export RECALL_API_KEY="op://${OP_PROD_VAULT_UID}/recall-production-api-key/credential"
export RECALL_API_BASE="https://us-west-2.recall.ai/api/v1"

# API-only Recall/Svix signing secret. The deployment workflow injects the
# protected value; this file deliberately preserves it without naming or
# reading a vault item.
export RECALL_WEBHOOK_SECRET="${RECALL_WEBHOOK_SECRET_INPUT:-${RECALL_WEBHOOK_SECRET:-}}"
# Safe cutover default: signed callbacks use the compatibility queue bridge
# until migration, worker, scheduler, and legacy-queue drain checks complete.
export DURABLE_WEBHOOK_INBOX_ENABLED="${DURABLE_WEBHOOK_INBOX_ENABLED_INPUT:-false}"

# tf uses this to configure the credentials on the postgres instance
export POSTGRES_USERNAME="op://${OP_PROD_VAULT_UID}/tix6rp52tsnbmho5lyarg6j2mq/username"
export POSTGRES_PASSWORD="op://${OP_PROD_VAULT_UID}/tix6rp52tsnbmho5lyarg6j2mq/credential"
EOF

# Database credential rollover is deliberately source-controlled in two phases.
# First set DATABASE_URL_V2_ENABLED=true while the selector stays on the old
# secret, apply the reviewed Terraform plan, then run the staged cutover
# operator.  Change the selector to database-url-v2 only after every workload
# has moved and been verified.  Reverting the selector to database-url is the
# durable rollback.  The disabled default never attempts to resolve the not-yet
# provisioned 1Password item.
export DATABASE_URL_V2_ENABLED=false
export DATABASE_URL_SECRET_NAME=database-url
if [ "$DATABASE_URL_V2_ENABLED" = true ]; then
  op_inject_source <<'EOF'
export DATABASE_URL_V2='op://${OP_PROD_VAULT_UID}/postgres-app-v2/python-connection-string'
EOF
else
  export DATABASE_URL_V2=
fi

export PORT=80


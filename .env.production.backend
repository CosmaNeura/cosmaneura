export AZURE_UPLOADS_ACCOUNT_URL="op://${OP_PROD_VAULT_UID}/azure-uploads-prod-runtime/website"
export AZURE_UPLOADS_CONTAINER_NAME="op://${OP_PROD_VAULT_UID}/azure-uploads-prod-runtime/uploads-container-name"
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME="op://${OP_PROD_VAULT_UID}/azure-uploads-prod-runtime/example-notes-container-name"

export AZURE_DEID_TENANT_ID="op://${OP_PROD_VAULT_UID}/azure-deid-prod-runtime/tenant-id"

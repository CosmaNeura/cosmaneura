export OP_SHARED_VAULT_UID=g46wit25zdsr2ul7yivj4air2u

op_inject_source <<'EOF'
export CLERK_PRIVATE_KEY='op://${OP_PROD_VAULT_UID}/clerk-production-api/secret_key'
export SOVEREIGN_RECORD_GRANT_SECRET='op://${OP_PROD_VAULT_UID}/sovereign-record-grant/credential'

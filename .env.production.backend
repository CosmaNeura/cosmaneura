export REDIS_URL='op://${OP_PROD_VAULT_UID}/redis-prod-database/python-connection-string'
export DATABASE_URL='op://${OP_PROD_VAULT_UID}/postgres-prod-database/python-connection-string'

export SESSION_SECRET_KEY="op://${OP_PROD_VAULT_UID}/x7hajpg3oohytjg555sixl6w3a/password"
export ENCRYPTION_KEY="op://${OP_PROD_VAULT_UID}/encryption-key-prod/password"

export ZOOM_CLIENT_ID="op://${OP_PROD_VAULT_UID}/zoom-cosma-app/client-id"

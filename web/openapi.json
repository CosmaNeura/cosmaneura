{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/v1/intake": {
      "get": {
        "tags": [
          "private"
        ],
        "summary": "Intake List",
        "operationId": "intake_list",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeList"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/internal/v1/notes": {
      "get": {
        "tags": [
          "private"
        ],
        "summary": "Note List",
        "description": "A separate endpoint is used to pull data for an individual note, so we just need the appointment ID\nat this point.",
        "operationId": "note_list",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotetakingData"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/internal/v1/notes/{appointment_id}": {
      "get": {
        "tags": [
          "private"
        ],
        "summary": "Note Detail",
        "operationId": "note_detail",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "appointment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Appointment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/visit-audio-file/get-signed-url": {
      "post": {
        "tags": [
          "private"
        ],
        "summary": "Generate Signed Upload Url",
        "operationId": "generate_signed_upload_url",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "title": "Response Generate Signed Upload Url Internal V1 Visit Audio File Get Signed Url Post"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/internal/v1/visit-audio-file/upload-complete": {
      "post": {
        "tags": [
          "private"
        ],
        "summary": "Upload Visit Audio File",
        "operationId": "upload_visit_audio_file",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "file_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/settings": {
      "get": {
        "tags": [
          "private"
        ],
        "summary": "Settings Data",
        "operationId": "settings_data",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsData"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/hello": {
      "get": {
        "summary": "Index",
        "operationId": "index",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/healthcheck": {
      "get": {
        "summary": "Healthcheck",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIVisitNote": {
        "properties": {
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "doctor_id": {
            "type": "string",
            "title": "Doctor Id"
          },
          "appointment_id": {
            "type": "string",
            "title": "Appointment Id"
          },
          "ai_transcript_id": {
            "type": "string",
            "title": "Ai Transcript Id"
          },
          "doctor_note_schema_id": {
            "type": "string",
            "title": "Doctor Note Schema Id"
          },
          "note": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Note",
            "description": "key is name of section, value is markdown content"
          },
          "note_type": {
            "type": "string",
            "title": "Note Type",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "appointment_id",
          "ai_transcript_id",
          "doctor_note_schema_id",
          "note",
          "note_type"
        ],
        "title": "AIVisitNote",
        "description": "This represents the note summary for a single specific note schema. A given appointment will have multiple\nAI visit notes.\n\nContents of the note are persisted for a long period of time and then eventually deleted.\n\nWe use soft deletion so we have a clear idea of when the note was deleted."
      },
      "AIVisitTranscript": {
        "properties": {
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Deleted At"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "doctor_id": {
            "type": "string",
            "title": "Doctor Id"
          },
          "appointment_id": {
            "type": "string",
            "title": "Appointment Id"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration",
            "description": "total length of the transcript, in seconds"
          },
          "transcript_data": {
            "items": {
              "$ref": "#/components/schemas/TranscriptEntry"
            },
            "type": "array",
            "title": "Transcript Data"
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "appointment_id",
          "patient_id",
          "duration",
          "transcript_data"
        ],
        "title": "AIVisitTranscript",
        "description": "Contents of the note are persisted for a long period of time and then eventually deleted.\n\nWe use soft deletion so we have a clear idea of when the note was deleted."
      },
      "Appointment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "doctor_id": {
            "type": "string",
            "title": "Doctor Id"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "appointment_date": {
            "type": "string",
            "format": "date-time",
            "title": "Appointment Date"
          },
          "patient_name": {
            "type": "string",
            "title": "Patient Name",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "patient_id",
          "appointment_date",
          "patient_name"
        ],
        "title": "Appointment",
        "description": "Represents an appointment with a patient from accuity"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntakeList": {
        "properties": {
          "appointments": {
            "items": {
              "$ref": "#/components/schemas/Appointment"
            },
            "type": "array",
            "title": "Appointments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appointments"
        ],
        "title": "IntakeList"
      },
      "NoteDetail": {
        "properties": {
          "appointment": {
            "$ref": "#/components/schemas/Appointment"
          },
          "transcript": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AIVisitTranscript"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AIVisitNote"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "patient": {
            "$ref": "#/components/schemas/Patient",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appointment",
          "transcript",
          "notes",
          "patient"
        ],
        "title": "NoteDetail"
      },
      "NotetakingData": {
        "properties": {
          "appointments": {
            "items": {
              "$ref": "#/components/schemas/Appointment"
            },
            "type": "array",
            "title": "Appointments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appointments"
        ],
        "title": "NotetakingData"
      },
      "Patient": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "doctor_id": {
            "type": "string",
            "title": "Doctor Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "title": "Date Of Birth"
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "name",
          "date_of_birth"
        ],
        "title": "Patient",
        "description": "Represents a patient in the system. This to simply help a doctor to find a transcript or intake.\n\nThis is not perfect:\n\n- Doctors will end up having patients with the same name\n- Patient name could be entered in multiple different ways\n\nFixing this is left as an exercise to the reader."
      },
      "SettingsData": {
        "properties": {
          "settings": {
            "type": "object",
            "title": "Settings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "settings"
        ],
        "title": "SettingsData"
      },
      "TranscriptEntry": {
        "properties": {
          "speaker": {
            "type": "string",
            "title": "Speaker"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "startTime": {
            "type": "integer",
            "title": "Starttime"
          },
          "endTime": {
            "type": "integer",
            "title": "Endtime"
          }
        },
        "type": "object",
        "required": [
          "speaker",
          "content",
          "startTime",
          "endTime"
        ],
        "title": "TranscriptEntry"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

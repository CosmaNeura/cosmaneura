  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@hey-api/openapi-ts": "^0.64.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^25.5.0",
    "@types/pluralize": "^0.0.33",
    "@types/ramda": "^0.30.2",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",

    "chrono-node": "^2.7.8",
    "class-variance-authority": "^0.7.1",
    "client": "link:client",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "downshift": "^9.0.9",
    "isbot": "^5.1.17",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lucide-react": "^0.483.0",
    "motion": "^12.38.0",
    "pluralize": "^8.0.0",
    "postcss": "^8.5.28",
    "posthog-js": "^1.232.6",
    "ramda": "^0.30.1",
    "react": "^19.0.8",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.0.8",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.2",

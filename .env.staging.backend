# NOTE this should be used by your deployment system to read in secrets for staging backend

export PYTHON_ENV=staging

export OP_STAGING_VAULT_UID=a747na7sgxngfa7gczsqqwekfq
export ENABLE_PROVIDER_V7="${ENABLE_PROVIDER_V7:-false}"
export ENABLE_SOVEREIGN_RECORD_GRANTS="${ENABLE_SOVEREIGN_RECORD_GRANTS:-false}"
# Keep staging Sentry dormant until its separate acceptance and source-controlled
# activation change are reviewed. The DSN remains in the staging vault below.
export SENTRY_STAGING_ENABLED=false

op_inject_source <<'EOF'
export DATABASE_URL='op://${OP_STAGING_VAULT_UID}/udnuqwjwscfcmyeo66dxrllxyi/python-connection-string'
export REDIS_URL='op://${OP_STAGING_VAULT_UID}/7cimllze2ua6val7zflrvdqsju/python-connection-string'
export SESSION_SECRET_KEY='op://${OP_STAGING_VAULT_UID}/6aogz2w4igrcfcrl3mxge5zedm/password'
export ENCRYPTION_KEY='op://${OP_STAGING_VAULT_UID}/6c2im6rb34knlpqyhf2hhpfuru/password'

export CLERK_PRIVATE_KEY='op://${OP_STAGING_VAULT_UID}/cxajltme2nqe7buvtpjp3q7lge/secret_key'
export CLERK_DEPLOYMENT_PUBLISHABLE_KEY='op://${OP_STAGING_VAULT_UID}/clerk-staging-api/publishable_key'

export SENTRY_DSN='op://${OP_STAGING_VAULT_UID}/sentry-runtime/backend-dsn'
export ASSEMBLY_API_KEY='op://${OP_STAGING_VAULT_UID}/assemblyai-runtime/api-key'

export AZURE_OPENAI_API_KEY='op://${OP_STAGING_VAULT_UID}/nb3ek7syndz57cezc3gkfi7eli/password'
export AZURE_OPENAI_ENDPOINT='op://${OP_STAGING_VAULT_UID}/nb3ek7syndz57cezc3gkfi7eli/website'

export AZURE_UPLOADS_ACCOUNT_NAME='op://${OP_STAGING_VAULT_UID}/vwwofyrfiymbcwyhfksd4k6tmu/account-name'
export AZURE_UPLOADS_ACCOUNT_KEY='op://${OP_STAGING_VAULT_UID}/vwwofyrfiymbcwyhfksd4k6tmu/password'
export AZURE_UPLOADS_CONTAINER_NAME='op://${OP_STAGING_VAULT_UID}/vwwofyrfiymbcwyhfksd4k6tmu/uploads-container-name'
export AZURE_UPLOADS_EXAMPLE_NOTES_CONTAINER_NAME='op://${OP_STAGING_VAULT_UID}/vwwofyrfiymbcwyhfksd4k6tmu/example-notes-container-name'

export AZURE_DEID_TENANT_ID='op://${OP_STAGING_VAULT_UID}/d2z7v2phde42uguohh4i6ymmfm/tenant-id'
export AZURE_DEID_CLIENT_ID='op://${OP_STAGING_VAULT_UID}/d2z7v2phde42uguohh4i6ymmfm/client-id'

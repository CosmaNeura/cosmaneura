EOF

# Staging remains default-off until its separate key is provisioned. Resolve
# the optional item only for an explicitly controlled activation.
if [[ "$ENABLE_SOVEREIGN_RECORD_GRANTS" == "true" ]]; then
	export SOVEREIGN_RECORD_GRANT_SECRET="$(
		op read "op://${OP_STAGING_VAULT_UID}/sovereign-record-grant/credential"
	)"
fi

export AZURE_UPLOADS_ACCOUNT_URL=https://cosmaneurastaginguploads.blob.core.windows.net

export ZOOM_REDIRECT_URI=https://staging-app.cosmaneura.com/external/v1/zoom-oauth-callback
export ZOOM_SUCCESS_REDIRECT=https://staging-app.cosmaneura.com/settings

# Public origin of the backend, used to build absolute callback URLs
# (e.g. zak_url passed to Recall when creating a bot).
export API_BASE_URL=https://staging-app.cosmaneura.com

# Staging has an independent test-mode integration and acquisition gate. The
# 1Password item contract matches production, but its item id is deliberately
# unset until the operator provisions the Stripe test account artifacts.
export STRIPE_INTEGRATION_ENABLED=false
export STRIPE_BILLING_ENABLED=false
export STRIPE_BILLING_ITEM_ID=
export STRIPE_LIVE_MODE=false
export STRIPE_SECRET_KEY=
export STRIPE_WEBHOOK_SECRET=
export STRIPE_ACCOUNT_ID=
export STRIPE_PRICE_ID=
# Must match the exact reviewed compatibility value pinned in source code.
export STRIPE_API_VERSION=2025-09-30.clover
if [[ "$STRIPE_INTEGRATION_ENABLED" == "true" ]]; then
	if [[ -z "$STRIPE_BILLING_ITEM_ID" ]]; then
		echo "STRIPE_BILLING_ITEM_ID is required when Stripe integration is enabled" >&2
		return 1
	fi
	op_inject_source <<'EOF'
export STRIPE_SECRET_KEY='op://${OP_STAGING_VAULT_UID}/${STRIPE_BILLING_ITEM_ID}/secret-key'
export STRIPE_WEBHOOK_SECRET='op://${OP_STAGING_VAULT_UID}/${STRIPE_BILLING_ITEM_ID}/webhook-secret'
export STRIPE_ACCOUNT_ID='op://${OP_STAGING_VAULT_UID}/${STRIPE_BILLING_ITEM_ID}/account-id'
export STRIPE_PRICE_ID='op://${OP_STAGING_VAULT_UID}/${STRIPE_BILLING_ITEM_ID}/price-id'
EOF
fi
export SCRIBE_HANDOFF_ENABLED=false
export ENTRA_TENANT_ID=d51754d0-bba5-4810-820e-afac542844d6
export SCRIBE_API_AUDIENCE=af957741-0342-498b-8496-e93706af9e99
export SCRIBE_CALLER_CLIENT_ID=cc522b51-278f-425e-99a5-5fc997c04c12
# Populate only after the dedicated reconciler identity exists; the endpoint fails closed meanwhile.
export SCRIBE_RECONCILER_CALLER_CLIENT_ID=
# Provider-first V7 authority/audit. Activation requires the isolated provider
# Sovereign runtime client ID plus its AgentApi.Access assignment. The public
# runtime is deliberately excluded and fails closed in this rollout.
export AUTHORITY_KERNEL_ENABLED="$ENABLE_PROVIDER_V7"
# Derive the exact issuer from the same protected Clerk instance configuration
# used by the frontend; do not maintain a second hard-coded identity boundary.
export AUTHORITY_CLERK_ISSUER="$(printf '%s' "$CLERK_DEPLOYMENT_PUBLISHABLE_KEY" | python scripts/superadmin_capability_config_preflight.py --environment staging --derive-issuer)"
export MOUNT_CONTEXT_TOKEN_TTL_SECONDS=900
export MOUNT_CONTEXT_TOKEN_REFRESH_AFTER_SECONDS=300
export MOUNT_CONTEXT_SESSION_MAX_AGE_SECONDS=28800
export AGENT_API_ENABLED="$ENABLE_PROVIDER_V7"
export AGENT_API_AUDIENCE=af957741-0342-498b-8496-e93706af9e99
export AGENT_API_SOVEREIGN_CLIENT_IDS=8cb2ecb5-3554-4405-be6f-5eda985c2f04
export SCRIBE_WORKFLOW_ENABLED=false
export COOKIE_DOMAIN=staging-app.cosmaneura.com

export RECALL_API_BASE=https://us-west-2.recall.ai/api/v1
export RECALL_WEBHOOK_SECRET="${RECALL_WEBHOOK_SECRET_INPUT:-${RECALL_WEBHOOK_SECRET:-}}"
export DURABLE_WEBHOOK_INBOX_ENABLED="${DURABLE_WEBHOOK_INBOX_ENABLED_INPUT:-${DURABLE_WEBHOOK_INBOX_ENABLED:-false}}"

export PORT=80
export LOG_LEVEL=info
export EMAIL_FROM_ADDRESS=hello@cosmaneura.com
export ALLOWED_HOST_LIST=staging-app.cosmaneura.com,staging-chat.cosmaneura.com
export INTAKE_CHAT_DOMAIN=staging-chat.cosmaneura.com

export SMTP_URL=smtp://fake_host.com:1025

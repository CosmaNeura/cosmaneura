export AZURE_DEID_ENDPOINT='op://${OP_STAGING_VAULT_UID}/d2z7v2phde42uguohh4i6ymmfm/endpoint'

export ZOOM_CLIENT_ID='op://${OP_STAGING_VAULT_UID}/zoom-cosma-app-staging/client-id'
export ZOOM_CLIENT_SECRET='op://${OP_STAGING_VAULT_UID}/zoom-cosma-app-staging/client-secret'
export ZOOM_SECRET_TOKEN='op://${OP_STAGING_VAULT_UID}/zoom-cosma-app-staging/secret-token'
